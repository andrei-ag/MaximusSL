real length;
integer handle;
string buf,filename;
write('Введите имя файла который вы хотите открыть: ');
read(filename);
fopen (filename,handle);
if (handle = -1) @er_open_file;
 write('Файл "',filename,'" был успешно открыт.\n');
 write('Сколько байт хотите записать? ');
 read(length);
 write('Что хотите записать? ');
 read(buf);
 fseek(handle,0,2);
 fwrite(handle,buf,length);
 fclose (handle);
 go to @wait;
:@er_open_file;
 write('Ошибка открытия файла "',filename,'"!\n');
 :@wait;
 write('Жду любой клавиши ...');
 pause;