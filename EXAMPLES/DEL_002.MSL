;═════════════════════════════════════════════════════════════════════════════
; Script name   : Пример "сложных" скриптов, для работы с файлами
; Script author : Агафонов Андрей Александрович [Most Needful Things]
; Script home   : http://amethyst.nm.ru
;
;  Удаление пользователей: с уровнем Limited (20) и не звонивших больше 3 дней
;                          с любым уровнем, не звонивших более 30 дней
;
;  Так же скрипт ведет файл отчета, о модификациях проведенных с базой
; пользователей.
;
integer handle,h_rep;
integer res_d,res_m,res_y;
integer cd,cm,cy,ld,lm,ly;
real i,m,n,user_max,user_del;
define  user_name      [0,2];
define  user_last_call [192,0];
define  user_priv_lev  [404,0];
string  file_name,rep_name;
;===
write('Введите путь (включая имя) к базе пользователей: ');
read(file_name);
fopen(file_name,handle);
if (handle != -1) @create_rep;
 write('Немогу открыть "',file_name,'"!');
 go to @quit;
;===
:@create_rep;
 write('Будем создавать файл отчета (y/n)? ');
 read(rep_name);
 if (rep_name != 'y' & rep_name != 'n') @create_rep;
 if (rep_name = 'n') @get_cur_date;
  write('Введите имя файлу - отчету: ');
  read(rep_name);
  fcreate(rep_name,h_rep);
 :@get_cur_date;
  write('Введите сегодняшнее число, месяц, год: ');
  read(cd,cm,cy);
  ftxt(h_rep,'Отчет от ',cd,'/',cm,'/',cy,'\n');
;===
 flength(handle,user_max);
 user_max = user_max / 460;
 write('База (',file_name,') содержит данные о ',user_max,' пользователях.\n');
 write('Сколько пользователей хотите проверить? ');
 :@read_no;
  read(user_max);
;===
 write('\nШёл один из суровых дней 1937 года...\nСегодня растреляны следующие вpаги наpода по причинам:\n\n');
 write(' враг народа (имя)                     нарушил закон\n');
 ftxt(h_rep,'\nШёл один из суровых дней 1937 года...\nСегодня растреляны следующие вpаги наpода по причинам:\n\n');
 ftxt(h_rep,' враг народа (имя)                     нарушил закон\n');
 :@start_loop;
  for (i=1,user_del=0; i > user_max; i=i+1,res_y=0)
   rd_user(handle,i);
   write('  ',user_name);
   ftxt(h_rep,'  ',user_name);
   str_len(user_name,m);
   m=36-m;
   for (n=0; n>m; n=n+1)
    write(' ');
    ftxt(h_rep,' ');
   end_for;
;===
   date_to_num(user_last_call,ld,lm,ly);
   ly=ly+1980;
;===
   if (ly = cy) @month;
    res_y = cy - ly;
    :@month;
     res_m = cm - lm + (res_y * 12);
     res_d = cd - ld + (res_m * 30);
;───
     if (res_d > 3 & user_priv_lev != 20) @check_30;
      dl_user(handle,i);
      i=i-1;
      write(' lastcall > 3 days (',res_d,') and privlevel = limited\n');
      ftxt(h_rep,' lastcall > 3 days (',res_d,') and privlevel = limited\n');
      user_del=user_del+1;
      go to @check_next;
;===
     :@check_30;
     if (res_d <= 30) @check_next;
      dl_user(handle,i);
      i=i-1;
      write(' lastcall > 30 days (',res_d,')\n');
      ftxt(h_rep,' lastcall > 30 days (',res_d,')\n');
      user_del=user_del+1;
    :@check_next;
     if (user_del < user_max) @cycle_quit;
      break;
   :@cycle_quit;
  end_for;
;───
  write('\nИтого: ',user_del,' трупов.');
  ftxt(h_rep,'\nИтого: ',user_del,' трупов.');
  if (h_rep = -1) @close_base;
   fclose(h_rep);
  :@close_base;
   fclose(handle);
   :@quit;
    write('\nНажмите любую клавишу для продолжения ...');
    pause;
