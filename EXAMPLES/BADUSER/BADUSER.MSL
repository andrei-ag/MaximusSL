;──────────────────────────────────
 define  user_name  [0,2];
;
 integer h1,h2,h3,cd,cm,cy,no,us;
 integer i,j,k,method,user_f,user_l;
 string  base_name,rep_name,list_name,mask,boolean,my_buf;
;──────────────────────────────────
get_date(cy,cd,cm);
write('Утилита для поиска двойников (c) 2001 Most Needful Things\n\nСегодня ',cd,'-',cm,'-',cy,'\n');
write('Введите путь и имя проверяемой базы: ');
read(base_name);
fopen(base_name,h1);
if (h1 != -1) report;
 write('Немогу открыть файл "',base_name,'"!\n');
 go to exit_from_scr2;
;──────────────────────────────────
:report;
 write('Создавать файл отчета (y/n)? ');
 read(boolean);
 if (boolean = 'y') create_rep;
  if (boolean = 'n') not_create_rep;
   write('Неправильный ответ "',boolean,'", введите "y" или "n"!\n');
   go to report;
;──────────────────────────────────
:create_rep;
 write('Введите путь и имя файла отчета: ');
 read(rep_name);
 fcreate(rep_name,h2);
 if (h2 != -1) not_create_rep;
  write('Немогу создать файл отчета "',rep_name,'"!\n');
:not_create_rep;
;──────────────────────────────────
ftxt(h2,'Отчет "Bad User Catcher", от ',cd,'-',cm,'-',cy,'\n\n');
:ch_methods;
 write('Искать двойников по:\n1) Проверять по заданой маске\n2) Сравнивать со списком плохих имен (из файла)\n3) Использовать 1 и 2 методы\n');
 read(method);
 if (method = 1 | method = 2 | method = 3) method_choose;
  write('Нет такого метода "',method,'"!\n');
  go to ch_methods;
;──────────────────────────────────
:method_choose;
 if (method = 2) get_bad_file;
  write('Введите маску поиска: ');
  read(mask);
  if (method = 1) enter_scan_loop;
;──────────────────────────────────
:get_bad_file;
 write('Введите путь и имя файла со списком масок (имен): ');
 read(list_name);
 fopen(list_name,h3);
 if (h3 != -1) enter_scan_loop;
 :choose_1q;
  write('Немогу открыть файл "',list_name,'"!\nИспользовать 1 метод или выйти из скрипта (1/q)? ');
  read(boolean);
  if (boolean = '1') use_first_m;
   if (boolean = 'q') exit_from_scr;
    write('Неправильный ответ "',boolean,'", введите "1" или "q"!\n');
    go to choose_1q;
:use_first_m;
 method = 1;
 go to method_choose;
;───────────────────────────────────
:enter_scan_loop;
 flength(h1,user_l);
 user_l=user_l/460;
 write('База пользователей "',base_name,'" содержит информацию о ',user_l,' пользователях.\n');
 write('С какого пользователя просканировать базу? ');
 read(user_f);
 write('По какого пользователя просканировать базу? ');
 read(user_l);
 write('\n');
;
 for (i=user_f,no=0,us=0; i>user_l; i=i+1,no=0)
  rd_user(h1,i);
  write(i,') ',user_name,': ');
  ftxt(h2,i,') ',user_name,': ');
;
  if (method = 2) ch_method_2;
   stri_find(user_name,mask,j);
   if (j = 0 & method = 3) ch_method_2;
    if (j = 0 & method = 1) next_user;
    no=no+1;
    write('совпала маска "',mask,'" ');
    ftxt(h2,'совпала маска "',mask,'" ');
    if (method != 3) next_user;
;
  :ch_method_2;
   fseek(h3,0,0);
   for (j=0,k=0; k=1; j++)
    fstr(h3,my_buf,255);
    stri_find(user_name,my_buf,k);
    if (k = 0) m2_loop;
     if (no = 0) first_mask;
      write(', ');
     :first_mask;
      write('совпала маска "',my_buf,'"');
      ftxt(h2,'совпала маска "',my_buf,'"');
      no=no+1;
    :m2_loop;
     feof(h3,k);
  end_for;
;
  :next_user;
   if (no != 0) user_bad_name;
    write('ничего не совпало');
    ftxt(h2,'ничего не совпало');
    go to user_bad_name2;
   :user_bad_name;
    us=us+1;
   :user_bad_name2;
    write('\n');
    ftxt(h2,'\n');
 end_for;
:exit_from_scr;
 fclose(h1);
 write('\nЗамечено ',us,' подозpительных пользователей!\n');
 ftxt(h2,'\nЗамечено ',us,' подозpительных пользователей!\n');
 fclose(h2);
 fclose(h3);
:exit_from_scr2;
 write('Жду любой клавиши ...');
 pause;
 exit;